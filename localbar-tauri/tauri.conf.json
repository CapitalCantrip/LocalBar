{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalBar",
  "version": "0.1.0",
  "identifier": "com.localbar.app",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "ui" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "LocalBar",
        "width": 320,
        "height": 400,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "LocalBar Settings",
        "width": 800,
        "height": 580,
        "visible": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1", "libwebkit2gtk-4.1-0"]
      }
    }
  }
}
